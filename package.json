{
  "name": "pandar-frontend-monorepo",
  "version": "0.2.0",
  "private": true,
  "workspaces": [
    "frontend",
    "frontend/auth",
    "frontend/plugin-local"
  ],
  "overrides": {
    "lodash": "4.18.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.25",
    "sharp": "0.35.3",
    "next@16.2.11": {
      "postcss": "8.5.25",
      "sharp": "0.35.3"
    }
  },
  "scripts": {
    "generate:hub-clients": "node scripts/generate-hub-clients.mjs",
    "check:hub-clients": "node scripts/generate-hub-clients.mjs --check",
    "build:plugin-local": "npm run build --workspace pandar-plugin-local",
    "build:web": "npm run build:plugin-local && npm run build --workspace pandar-web",
    "build:auth": "npm run build --workspace pandar-auth",
    "test:web": "npm run test --workspace pandar-web",
    "test:auth": "npm run test --workspace pandar-auth",
    "lint:web": "npm run lint --workspace pandar-web",
    "typecheck:web": "npm run typecheck --workspace pandar-web",
    "typecheck:auth": "npm run typecheck --workspace pandar-auth"
  },
  "dependencies": {
    "@base-ui/react": "1.6.0",
    "@better-auth/passkey": "1.6.25",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-devtools": "5.101.4",
    "better-auth": "1.6.25",
    "better-sqlite3": "12.11.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dayjs": "1.11.21",
    "lucide-react": "1.22.0",
    "next": "16.2.11",
    "next-intl": "4.13.0",
    "nodemailer": "9.0.1",
    "radix-ui": "1.6.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zustand": "5.0.9"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "25.0.2",
    "@types/nodemailer": "8.0.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "auth": "1.6.25",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "shadcn": "4.14.1",
    "tailwindcss": "4.3.1",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
