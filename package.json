{
  "name": "pandar-frontend-monorepo",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["frontend", "frontend/auth", "frontend/plugin-local"],
  "overrides": {
    "lodash": "4.18.1",
    "postcss": "8.5.20"
  },
  "scripts": {
    "build:plugin-local": "npm run build --workspace pandar-plugin-local",
    "build:web": "npm run build:plugin-local && npm run build --workspace pandar-web",
    "build:auth": "npm run build --workspace pandar-auth",
    "test:web": "npm run test --workspace pandar-web",
    "test:auth": "npm run test --workspace pandar-auth",
    "lint:web": "npm run lint --workspace pandar-web",
    "typecheck:web": "npm run typecheck --workspace pandar-web",
    "typecheck:auth": "npm run typecheck --workspace pandar-auth"
  }
}
